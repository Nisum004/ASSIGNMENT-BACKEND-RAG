# Copy this file to .env and fill in your own API keys.

APP_NAME="Assignment Backend RAG"
ENVIRONMENT=local
API_PREFIX=/api/v1

REDIS_URL=redis://localhost:6379/0

VECTOR_PROVIDER=pinecone
VECTOR_DIMENSION=384

PINECONE_API_KEY=....
PINECONE_INDEX_NAME=rag-documents
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

OPENAI_API_KEY=.....
HUGGINGFACE_API_KEY=.....
HUGGINGFACE_EMBEDDING_URL=https://router.huggingface.co/hf-inference/models/sentence-transformers/all-MiniLM-L6-v2/pipeline/feature-extraction
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

GROQ_API_KEY=.....
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b

DEFAULT_TOP_K=5
MAX_UPLOAD_MB=20
CHAT_MEMORY_TTL_SECONDS=604800
